{
  "name": "@grace-abounds/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./test-env": "./src/test-env.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prisma:validate": "dotenv -e ../../.env -- prisma validate",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "staff:add": "dotenv -e ../../.env -- tsx scripts/staff-add.ts",
    "postinstall": "prisma generate",
    "migrate:test": "dotenv -e ../../.env -- sh -c 'case \"$TEST_DATABASE_URL\" in *_test*) DATABASE_URL=\"$TEST_DATABASE_URL\" prisma migrate deploy ;; *) echo \"TEST_DATABASE_URL must name a _test database\"; exit 1 ;; esac'",
    "content:seed": "dotenv -e ../../.env -- tsx scripts/content-seed.ts"
  },
  "dependencies": {
    "@grace-abounds/validation": "workspace:*",
    "@prisma/client": "^6.15.0"
  },
  "devDependencies": {
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "dotenv-cli": "^8.0.0"
  }
}
