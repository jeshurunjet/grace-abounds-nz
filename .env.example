# Copy to .env for local development. Never commit real secrets.
# Production: set these as environment variables on each host instead.

# ---------- Database (docker compose up -d) ----------
POSTGRES_DB=grace_abounds
POSTGRES_USER=grace_abounds
POSTGRES_PASSWORD=local_development_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://grace_abounds:local_development_only@localhost:5432/grace_abounds?schema=public

# ---------- Addresses ----------
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the Next.js gateway reaches the API (private network in production).
API_INTERNAL_URL=http://localhost:4000
# The site's own origin. Auth.js uses it for callbacks; mutations from any
# other origin are refused.
AUTH_URL=http://localhost:3000
# true only when a trusted host/proxy sets the Host header (production hosts).
AUTH_TRUST_HOST=false
# Number of trusted proxies in front of the site that append X-Forwarded-For.
# 0 locally (no proxy). Set to the real number in staging/production.
TRUSTED_PROXY_HOPS=0

# ---------- Secrets (generate each with: openssl rand -base64 48) ----------
# Auth.js session/cookie secret. Required in every environment.
AUTH_SECRET=replace-with-a-long-random-secret
# Keys the hashes of six-digit sign-up/reset/re-authentication codes.
# 32+ characters, different from the other secrets.
AUTH_CHALLENGE_SECRET=replace-with-a-third-long-random-secret
# Signs the 60-second identity assertion from the website to the API.
# Must be identical for web and API, 32+ characters.
API_ASSERTION_SECRET=replace-with-a-different-long-random-secret

# ---------- Google login (optional locally; button hidden when unset) ----------
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------- Email sign-in codes ----------
# Leave RESEND_API_KEY empty locally: codes print in the web server console.
RESEND_API_KEY=
EMAIL_FROM="Grace Abounds <no-reply@your-church-domain>"

# ---------- Integration tests (never point at a real database) ----------
# Must name a database ending in _test; tests delete identity rows there.
TEST_DATABASE_URL=postgresql://grace_abounds:local_development_only@localhost:5432/grace_abounds_test?schema=public
