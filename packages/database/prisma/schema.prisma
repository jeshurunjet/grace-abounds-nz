generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity (Phase 1) ----------

enum Role {
  MEMBER
  ADMIN
  PASTOR
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
}

/// One canonical person. Pastor/Admin are created by the staff:add command;
/// sign-up always creates a MEMBER.
model User {
  id            String        @id @default(cuid())
  /// Always stored lowercase and trimmed.
  email         String        @unique
  emailVerified DateTime?
  name          String?
  image         String?
  bio           String        @default("")
  phone         String        @default("")
  role          Role          @default(MEMBER)
  status        AccountStatus @default(ACTIVE)
  /// Incremented on every profile write; used for If-Match checks.
  version       Int           @default(1)
  /// Argon2id hash. Only set after the email address has been verified.
  passwordHash      String?
  passwordUpdatedAt DateTime?
  /// Incrementing this ends every existing session on the next request.
  sessionVersion    Int       @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  accounts       Account[]
  sessions       UserSession[]
  authenticators Authenticator[]
  challenges     AuthChallenge[]
  auditEvents    AuditEvent[]    @relation("AuditActor")
  siteEdits      SiteSettings[]    @relation("SiteSettingsEditor")
  pageEdits      PageContent[]     @relation("PageContentEditor")
  contentRevisions ContentRevision[] @relation("ContentRevisionActor")
}

// Auth.js Prisma adapter tables (https://authjs.dev/getting-started/adapters/prisma)

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

/// Server record of a signed-in browser. The JWT cookie carries its id (sid)
/// and the user's sessionVersion (sv); both are checked on every protected
/// request, so revocation takes effect immediately.
model UserSession {
  id              String    @id @default(cuid())
  userId          String
  /// User.sessionVersion when this session was created.
  sessionVersion  Int
  /// How the person signed in: password, email-code, google, passkey.
  method          String
  /// Short device description for the Settings list (no full user agent).
  deviceLabel     String    @default("")
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  /// Last real authentication (sign-in or re-authentication). Session
  /// refreshes never move this; sensitive changes require it to be recent.
  authenticatedAt DateTime  @default(now())
  /// Absolute expiry; matches the cookie lifetime set at sign-in.
  expiresAt       DateTime
  revokedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

enum ChallengePurpose {
  SIGNUP_VERIFY
  PASSWORD_RESET
  REAUTH
}

/// Six-digit codes for sign-up verification, password reset and
/// re-authentication. Email-code sign-in uses Auth.js VerificationToken, so
/// a code for one purpose can never be used for another.
model AuthChallenge {
  id                  String           @id @default(cuid())
  purpose             ChallengePurpose
  /// Normalized email the code was sent to.
  email               String
  userId              String?
  /// HMAC-SHA256 with AUTH_CHALLENGE_SECRET, bound to purpose and email.
  codeHash            String
  /// Sign-up only: the password and name submitted with this request. They
  /// become an account only when this exact challenge is verified.
  pendingPasswordHash String?
  pendingName         String?
  attempts            Int              @default(0)
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([purpose, email, consumedAt])
}

/// Holds hashed six-digit email sign-in codes.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/// Passkeys (WebAuthn credentials).
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

/// Fixed-window counters for sign-in code requests and verification attempts.
model AuthAttempt {
  key         String   @id
  count       Int
  windowStart DateTime
}

// ---------- Audit ----------

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  requestId  String?
  /// Never store prayer/message bodies or credentials here.
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ---------- Website content (Phase 2) ----------

/// Shared church settings (contact, social, sign-in verses, giving details).
/// One row, id 'site'. `data` is validated by siteSettingsSchema.
model SiteSettings {
  id          String   @id @default("site")
  data        Json
  /// Incremented on every save; If-Match checks use it.
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation("SiteSettingsEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// One row per public page section ('home', 'about', ...). `data` is
/// validated by pageSchemas[key]. Saving publishes immediately.
model PageContent {
  key         String   @id
  data        Json
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation("PageContentEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Every saved version of a content record, written in the same transaction
/// as the save. Restore creates a new revision (restoredFromId).
model ContentRevision {
  id             String   @id @default(cuid())
  entityType     String
  entityKey      String
  version        Int
  data           Json
  actorId        String?
  restoredFromId String?
  createdAt      DateTime @default(now())

  actor User? @relation("ContentRevisionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([entityType, entityKey, version])
  @@index([entityType, entityKey, createdAt])
}

// ---------- Phase 2B: editorial collections ----------
// Each record saves on its own with If-Match on `version`; every save writes
// a ContentRevision (entityType = collection name, entityKey = id) and an
// AuditEvent in the same transaction. Drafts and archived records never
// appear in public or member responses.

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ResourceVisibility {
  /// Anyone may open it once published.
  PUBLIC
  /// Signed-in members only.
  MEMBERS
}

/// A campus. `key` is the stable id activities refer to ('manukau').
model Location {
  id          String        @id @default(cuid())
  key         String        @unique
  name        String
  kind        String        @default("")
  address     String        @default("")
  image       String        @default("")
  position    Int           @default(0)
  status      ContentStatus @default(DRAFT)
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  updatedById String?

  @@index([status, position])
}

/// A Next steps journey shown on the public Next steps page.
model NextStep {
  id          String        @id @default(cuid())
  title       String
  subtitle    String        @default("")
  heading     String        @default("")
  body        String        @default("")
  icon        String        @default("")
  /// Where the call to action goes: interest | appointment | calendar | link.
  ctaKind     String        @default("interest")
  ctaLabel    String        @default("")
  /// interest: request name; calendar: activity slug (optional); link: URL.
  ctaTarget   String        @default("")
  path        String[]
  position    Int           @default(0)
  status      ContentStatus @default(DRAFT)
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  updatedById String?

  @@index([status, position])
}

/// A leadership profile on the About page.
model TeamMember {
  id          String        @id @default(cuid())
  name        String
  role        String        @default("")
  bio         String        @default("")
  image       String        @default("")
  position    Int           @default(0)
  status      ContentStatus @default(DRAFT)
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  updatedById String?

  @@index([status, position])
}

/// A folder in the shared library (Gallery).
model ResourceFolder {
  id          String   @id @default(cuid())
  name        String
  parentId    String?
  position    Int      @default(0)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  parent    ResourceFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  ResourceFolder[] @relation("FolderTree")
  resources Resource[]
}

/// Library metadata. The file itself is a separate asset (uploads arrive in
/// Phase 2D); until then `url` holds an https link or a site path.
model Resource {
  id          String             @id @default(cuid())
  title       String
  description String             @default("")
  type        String             @default("Document")
  url         String             @default("")
  /// Set when uploads exist (Phase 2D): the stored file for this resource.
  assetId     String?
  folderId    String?
  visibility  ResourceVisibility @default(MEMBERS)
  position    Int                @default(0)
  status      ContentStatus      @default(DRAFT)
  version     Int                @default(1)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  updatedById String?
  /// An approved sermon shown in the library; listed only while it is live.
  sermonId    String?

  folder ResourceFolder? @relation(fields: [folderId], references: [id], onDelete: Restrict)
  asset  Asset?          @relation(fields: [assetId], references: [id], onDelete: Restrict)
  sermon Sermon?         @relation(fields: [sermonId], references: [id], onDelete: Restrict)

  @@index([status, position])
}

enum AssetAccess {
  PUBLIC
  MEMBERS
  PRIVATE
}

enum AssetStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// One stored file. Uploads arrive in Phase 2D; the model is defined now so
/// resources and sermons refer to files by ID (one store, no copies). A file
/// is never served until VERIFIED, and video access also needs an approved
/// sermon.
model Asset {
  id          String      @id @default(cuid())
  storageKey  String      @unique
  fileName    String
  contentType String
  size        Int
  access      AssetAccess @default(PRIVATE)
  status      AssetStatus @default(PENDING)
  ownerId     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  resources Resource[]
  sermons   Sermon[]   @relation("SermonMedia")
}

enum SermonReview {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

/// Sermons & videos. Staff save a working copy; only the Pastor approves an
/// exact saved version, which is copied to `live` (the public version). A
/// later change needs approval again while `live` stays published.
model Sermon {
  id           String       @id @default(cuid())
  slug         String       @unique
  title        String
  series       String       @default("")
  speaker      String       @default("")
  date         DateTime     @db.Date
  duration     String       @default("")
  image        String       @default("")
  summary      String       @default("")
  /// Direct https:// recording link until uploads exist.
  mediaUrl     String       @default("")
  mediaAssetId String?
  review       SermonReview @default(DRAFT)
  reviewNote   String       @default("")
  reviewedById String?
  reviewedAt   DateTime?
  /// The approved public fields; null when nothing is live.
  live         Json?
  liveVersion  Int?
  approvedById String?
  approvedAt   DateTime?
  archivedAt   DateTime?
  version      Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  updatedById  String?

  mediaAsset Asset?    @relation("SermonMedia", fields: [mediaAssetId], references: [id], onDelete: Restrict)
  resources  Resource[]

  @@index([review])
  @@index([date])
}
